
# =============================================================================
# TrustGuard-AI — Production .gitignore
# =============================================================================

# Environment & Secrets
.env
.env.*
!.env.example
backend/.env
frontend/.env

# Python & Bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.so
build/
dist/
*.egg
*.egg-info/
.eggs/

# Virtual Environments
.venv/
venv/
env/
ENV/

# Datasets & Label Caches
dataset/train/images/*
!dataset/train/images/.gitkeep
dataset/train/labels/*
!dataset/train/labels/.gitkeep

dataset/valid/images/*
!dataset/valid/images/.gitkeep
dataset/valid/labels/*
!dataset/valid/labels/.gitkeep

dataset/test/images/*
!dataset/test/images/.gitkeep
dataset/test/labels/*
!dataset/test/labels/.gitkeep

# Dataset caches and generated label-check images
*.cache
dataset/**/*.cache
label_check/

# Review datasets
backend/data/*.csv

# ML Model Weights & Checkpoints
*.pt
*.pth
*.onnx
runs/
backend/damage_detector/saved_models/*.pt
!backend/damage_detector/saved_models/.gitkeep

# Legacy model files
backend/models/keras_model.h5
backend/models/labels.txt

# Keep backend/models/lr_pipeline.joblib for inference

# Databases
*.db
*.sqlite
*.sqlite3
backend/data/*.db
!backend/data/.gitkeep

# Logs & Runtime Data
*.log
backend/logs/*.log
backend/logs/*.json
!backend/logs/.gitkeep

# Generated Reports
reports/*.pdf
!reports/.gitkeep

# Evaluation outputs
evaluation_outputs/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
dist-ssr/
*.local

# IDE, Agent & System Files
.agents/
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
