{
  "manifest_version": 3,
  "name": "TrustGuard AI",
  "version": "1.0",
  "description": "Real-time Fake Review Detection & Trust Analysis for Amazon and Flipkart",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8001/*"
  ]
}
