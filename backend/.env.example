# TrustGuard-AI Environment Variables
# Copy this file to .env and fill in your values

# ── RapidAPI (for Live Amazon/Flipkart Data) ──────────────────────────────────
# Get at: https://rapidapi.com → search "Real-Time Amazon Data" → subscribe free tier
# Then copy your X-RapidAPI-Key from the dashboard
RAPIDAPI_KEY=your_rapidapi_key_here

# ── Rainforest API (Alternative Amazon API) ───────────────────────────────────
# Get at: https://rainforestapi.com → free trial available
RAINFOREST_API_KEY=your_rainforest_key_here

# ── Email (SMTP) Configuration ────────────────────────────────────────────────
# For Gmail: enable 2FA → Google Account → Security → App Passwords → create one
# The App Password is 16 chars (e.g., "abcd efgh ijkl mnop" without spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_app_password_here

# ── Email Recipients ──────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ANALYST_EMAIL=analyst@yourdomain.com
